# Compiled binaries
*.exe
*.out
*.o
*.obj
*.a
*.lib
*.dll

# Python build/test bytecode
__pycache__/
*.pyc

# Build folders
data/.runtime/
build/
bin/
cmake-build-debug/
cmake-build-release/

# VS Code
.vscode/

# Visual Studio / Windows
*.pdb
*.ilk
*.idb

# Temporary/editor files
*.tmp
*.log
*.swp
*.swo
*~
.env
.env.*
!.env.example

# Generated images or exports if you do not want to track them
# Uncomment if needed
# *.png
# *.pdf

# Keep CSV input data tracked, but ignore generated allocation export if desired
# Uncomment only if allocations.csv is generated and should not be committed
# data/allocations.csv

# Personal agent/development instructions remain local only.
/AGENTS.md
/docs/development/

# Private work reports and progress/cleanup notes.
/docs/iteration-reports/Iteration_41.md
/docs/iteration-reports/*_progress.md
/docs/architecture/csv-cleanup.md

# Raw Student acceptance captures are reproducible local evidence. Keep only
# deliberately reviewed representatives and compact summaries in Git.
/docs/ui/student-portal/**/modules/
/docs/ui/student-portal/**/post-states.json
/docs/ui/student-portal/**/persistence.json
/docs/ui/student-portal/**/controls.json
/docs/ui/student-portal/**/tests.txt
/docs/ui/student-portal/**/*.png
/docs/ui/student-portal-ui01/*.png

# Professor raw acceptance output follows the same evidence policy.
/docs/professor-services/**/post-states.json
/docs/professor-services/**/persistence.json
/docs/professor-services/**/controls.json
/docs/professor-services/**/control-trace.json
/docs/professor-services/**/tests.txt
/docs/professor-services/**/*.png
