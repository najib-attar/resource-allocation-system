# Configure a dedicated PostgreSQL database; do not commit your actual URL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/resource_allocation
RESOURCE_ALLOCATION_DB_LOCK_TIMEOUT=5
RESOURCE_ALLOCATION_ENGINE_TIMEOUT=30
# Generate privately with secrets.token_hex(32); never use this placeholder.
RESOURCE_ALLOCATION_SECRET_KEY=
RESOURCE_ALLOCATION_TIMEZONE=Europe/Istanbul
# Student single-room selection; independent of academic/exam strategy config.
RESOURCE_ALLOCATION_ROOM_STRATEGY=best_fit
# Set to 1 behind HTTPS. Local HTTP development needs 0.
RESOURCE_ALLOCATION_SECURE_COOKIE=0
RESOURCE_ALLOCATION_DEBUG=0
# Integration tests require an isolated database, never the application database.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/resource_allocation_test
